	10: CopyLoc[5](t2#1#4: &vector<u8>)
	11: Eq
	12: Not
	13: BrFalse(30)
B1:
	14: LdConst[2](vector<u8>: "Ass..)
	15: Call string::utf8(vector<u8>): String
	16: StLoc[0](%#1: String)
	17: ImmBorrowLoc[0](%#1: String)
	18: Call debug::print<String>(&String)
	19: MoveLoc[3](t1#1#4: &vector<u8>)
	20: Call debug::print<vector<u8>>(&vector<u8>)
	21: LdConst[3](vector<u8>: "!="..)
	22: Call string::utf8(vector<u8>): String
	23: StLoc[1](%#2: String)
	24: ImmBorrowLoc[1](%#2: String)
	25: Call debug::print<String>(&String)
	26: MoveLoc[5](t2#1#4: &vector<u8>)
