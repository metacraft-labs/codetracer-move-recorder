	29: Abort
B2:
	30: MoveLoc[5](t2#1#4: &vector<u8>)
	31: Pop
	32: MoveLoc[3](t1#1#4: &vector<u8>)
	33: Pop
	34: Ret
}

entry public unit_test_poison() {
B0:
	0: Call unit_test::poison()
	1: Ret
}

Constants [
	0 => vector<u8>: "abc" // interpreted as UTF8 string
	1 => vector<u8>: 20ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
	2 => vector<u8>: "Assertion failed:" // interpreted as UTF8 string
