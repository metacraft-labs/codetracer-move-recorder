	35: ImmBorrowField[0](Registry.id: UID)
	36: MoveLoc[6](key#1#0: String)
	37: Call derived_object::exists<String>(&UID, String): bool
	38: BrFalse(40)
B1:
	39: Branch(42)
B2:
	40: LdU64(13906834333257170943)
	41: Abort
B3:
	42: ImmBorrowLoc[7](registry#1#0: Registry)
	43: ImmBorrowField[0](Registry.id: UID)
	44: MoveLoc[2](another_key#1#0: String)
	45: Call derived_object::exists<String>(&UID, String): bool
	46: BrFalse(48)
B4:
	47: Branch(50)
B5:
	48: LdU64(13906834337552138239)
	49: Abort
B6:
	50: ImmBorrowLoc[5](derived_uid#1#0: UID)
	51: Call object::uid_to_address(&UID): address
