	14: Call object::uid_to_inner(&UID): ID
	15: CopyLoc[6](key#1#0: String)
	16: Call derived_object::derive_address<String>(ID, String): address
	17: StLoc[4](derived_id#1#0: address)
	18: ImmBorrowLoc[7](registry#1#0: Registry)
	19: ImmBorrowField[0](Registry.id: UID)
	20: Call object::uid_to_inner(&UID): ID
	21: CopyLoc[2](another_key#1#0: String)
	22: Call derived_object::derive_address<String>(ID, String): address
	23: StLoc[0](another_derived_id#1#0: address)
	24: MutBorrowLoc[7](registry#1#0: Registry)
	25: MutBorrowField[0](Registry.id: UID)
	26: CopyLoc[6](key#1#0: String)
