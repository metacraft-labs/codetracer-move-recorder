test_public_split_join_zero_destroy() {
L0:	%#1: TxContext
L1:	ctx#1#0: &mut TxContext
L2:	split#1#0: Token<TEST>
L3:	token#1#0: Token<TEST>
L4:	zero#1#0: Token<TEST>
B0:
	0: LdConst[0](address: 0x00..)
