	10: LdU64(50)
	11: CopyLoc[1](ctx#1#0: &mut TxContext)
	12: Call token::split<TEST>(&mut Token<TEST>, u64, &mut TxContext): Token<TEST>
	13: StLoc[2](split#1#0: Token<TEST>)
	14: CopyLoc[1](ctx#1#0: &mut TxContext)
	15: Call token::zero<TEST>(&mut TxContext): Token<TEST>
	16: StLoc[4](zero#1#0: Token<TEST>)
	17: MutBorrowLoc[3](token#1#0: Token<TEST>)
	18: MoveLoc[2](split#1#0: Token<TEST>)
	19: Call token::join<TEST>(&mut Token<TEST>, Token<TEST>)
	20: MutBorrowLoc[3](token#1#0: Token<TEST>)
	21: MoveLoc[4](zero#1#0: Token<TEST>)
	22: Call token::join<TEST>(&mut Token<TEST>, Token<TEST>)
	23: MutBorrowLoc[3](token#1#0: Token<TEST>)
	24: LdU64(0)
	25: CopyLoc[1](ctx#1#0: &mut TxContext)
	26: Call token::split<TEST>(&mut Token<TEST>, u64, &mut TxContext): Token<TEST>
	27: Call token::destroy_zero<TEST>(Token<TEST>)
	28: MoveLoc[3](token#1#0: Token<TEST>)
	29: MoveLoc[1](ctx#1#0: &mut TxContext)
	30: Call token::keep<TEST>(Token<TEST>, &mut TxContext)
